# ──────────────────────────────────────────────────────
#  Satellite Environmental Analytics System
#  Environment Variables Template
#
#  Copy this file to .env and fill in your real values:
#    cp .env.example .env
# ──────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────
PORT=4000                   # frontend defaults to localhost:4000
HOST=0.0.0.0
NODE_ENV=development        # development | production

# ── PostgreSQL Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satellite_analytics
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=10

# Set to "true" if connecting to a cloud DB with SSL (e.g. Supabase, Neon, Railway)
DB_SSL=false

# ── CORS ─────────────────────────────────────────────────
# Must be an exact origin (not *) when the frontend sends cookies (credentials:true)
CORS_ORIGIN=http://localhost:3000

# ── JWT Auth ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use DIFFERENT secrets for access vs refresh tokens.
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Email / SMTP ──────────────────────────────────────────────────
# For Gmail: enable 2FA → Security → App Passwords → generate one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Satya <your_email@gmail.com>

# ── Google Earth Engine (GEE) ──────────────────────────────────────
# Enables real Sentinel-2 band extraction in POST /api/analytics/process.
# Without these, the endpoint requires manual t1_bands/t2_bands values.
#
# Setup:
#   1. console.cloud.google.com → enable "Earth Engine API"
#   2. IAM → Service Accounts → create → Keys → JSON → download
#   3. Register at https://code.earthengine.google.com/register
#
# Option A — key file path (local dev):
GEE_KEY_FILE=./gee-service-account-key.json
# Option B — inline JSON (for hosted envs like Railway/Render):
# GEE_KEY_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
GEE_PROJECT=your-google-cloud-project-id
