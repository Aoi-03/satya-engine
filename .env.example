# ════════════════════════════════════════════════════════════════════════════
#  RAILWAY DEPLOYMENT GUIDE — Satellite Environmental Analytics Backend
#  Last updated: 2026-08-18
#
#  HOW TO USE THIS FILE ON RAILWAY
#  ────────────────────────────────
#  1. Go to Railway → your backend service → "Variables" tab
#  2. Click "RAW Editor" (top-right of the variables panel)
#  3. Paste ONLY the KEY=VALUE lines marked ✅ REQUIRED below
#  4. Do NOT set PORT — Railway assigns it automatically
#  5. Click "Update Variables" → Railway redeploys automatically
#
#  LOCAL DEV
#  ─────────
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ════════════════════════════════════════════════════════════════════════════


# ── Server ───────────────────────────────────────────────────────────────────
#
#  ⛔ DO NOT SET PORT ON RAILWAY.
#     Railway assigns $PORT automatically. If you hardcode it to 4000
#     Railway's load balancer can't find your process → 502 Bad Gateway.
#
#  Local dev only — uncomment below:
# PORT=4000

HOST=0.0.0.0                    # ✅ REQUIRED on Railway

NODE_ENV=production              # ✅ REQUIRED on Railway  (use "production")
                                 #    Local dev: change to "development"


# ── PostgreSQL / Supabase ────────────────────────────────────────────────────
#  ✅ ALL REQUIRED

DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.bokpzxqymsrkrocpkpuk
DB_PASSWORD=Shorekeeper@1212
DB_SSL=true

# Full connection string (used as fallback by some DB clients)
DATABASE_URL=postgresql://postgres.bokpzxqymsrkrocpkpuk:Shorekeeper@1212@aws-0-ap-south-1.pooler.supabase.com:5432/postgres


# ── CORS ─────────────────────────────────────────────────────────────────────
#  ✅ REQUIRED — set to your ACTUAL deployed frontend URL.
#
#  Railway example:  https://your-frontend.up.railway.app
#  Vercel example:   https://your-frontend.vercel.app
#  Multiple origins: comma-separate them (no spaces)
#    CORS_ORIGIN=https://frontend.vercel.app,https://frontend.railway.app
#
#  ⛔ DO NOT USE http://localhost:3000 on Railway — it blocks all browser requests.

CORS_ORIGIN=https://YOUR_FRONTEND_URL_HERE.vercel.app


# ── JWT Auth ─────────────────────────────────────────────────────────────────
#  ✅ REQUIRED — use the pre-generated secrets below (or generate your own).
#  Generate new ones: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#  ⛔ NEVER reuse the same value for both secrets.

JWT_ACCESS_SECRET=a4205c4ad1f3a82d36c56026561d67d38c456f09a7d8a1b405063c007f571fe9ce16813bca149f45fad2e07c18c82fff4813aab9adeb90ecabc637b868d326c5
JWT_REFRESH_SECRET=913f03f06367cc496cbb6d30a33c77dd6aa84c043202f8aa1c2c81a89ea9c9371079cf338b3a2470bc01b0fa77901b79ade5b4e75679c7501b6db533e0e54f84
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d


# ── Email / SMTP ─────────────────────────────────────────────────────────────
#  ⚪ OPTIONAL — only needed for forgot-password email flow.
#  Gmail setup: enable 2FA → Google Account → Security → App Passwords → generate

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=Satya <your_gmail@gmail.com>


# ── Google Earth Engine (GEE) ─────────────────────────────────────────────────
#  ✅ REQUIRED for real satellite band extraction.
#
#  IMPORTANT — On Railway set GEE_SERVICE_ACCOUNT_KEY as ONE variable
#  containing the ENTIRE contents of your gee-key.json file as a JSON string.
#
#  How to set it:
#    1. Open config/gee-key.json in a text editor
#    2. Select ALL (Ctrl+A), Copy (Ctrl+C)
#    3. In Railway Variables → RAW Editor, paste as:
#       GEE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":...}
#       (the entire JSON on one line — Railway handles multiline values fine)
#
#  ⛔ DO NOT add "type", "project_id", "private_key" etc. as separate variables.
#     They will be ignored — the code only reads GEE_SERVICE_ACCOUNT_KEY.

GEE_PROJECT=cogent-summer-505718-a2
GEE_SERVICE_ACCOUNT_KEY=PASTE_ENTIRE_GEE_KEY_JSON_HERE


# ════════════════════════════════════════════════════════════════════════════
#  RAILWAY QUICK-COPY CHECKLIST
#  Variables you MUST set in Railway RAW editor:
#  ─────────────────────────────────────────────
#  ✅ HOST
#  ✅ NODE_ENV
#  ✅ DB_HOST
#  ✅ DB_PORT
#  ✅ DB_NAME
#  ✅ DB_USER
#  ✅ DB_PASSWORD
#  ✅ DB_SSL
#  ✅ DATABASE_URL
#  ✅ CORS_ORIGIN           ← your real frontend URL, not localhost
#  ✅ JWT_ACCESS_SECRET
#  ✅ JWT_REFRESH_SECRET
#  ✅ JWT_ACCESS_TTL
#  ✅ JWT_REFRESH_TTL
#  ✅ GEE_PROJECT
#  ✅ GEE_SERVICE_ACCOUNT_KEY  ← entire gee-key.json content as one value
#
#  Variables to NEVER set on Railway:
#  ───────────────────────────────────
#  ⛔ PORT  — Railway assigns this automatically
#  ⛔ type, project_id, private_key, client_email, etc. (GEE fields individually)
# ════════════════════════════════════════════════════════════════════════════
