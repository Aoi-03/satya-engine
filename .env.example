# ──────────────────────────────────────────────────────
#  Satellite Environmental Analytics System
#  Environment Variables Template
#
#  Copy this file to .env and fill in your real values:
#    cp .env.example .env
# ──────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development        # development | production

# ── PostgreSQL Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satellite_analytics
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=10

# Set to "true" if connecting to a cloud DB with SSL (e.g. Supabase, Neon, Railway)
DB_SSL=false

# ── CORS ─────────────────────────────────────────────────
# Use * for development, restrict to your frontend origin in production
CORS_ORIGIN=*
